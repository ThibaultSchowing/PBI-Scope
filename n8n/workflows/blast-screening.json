    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. Convert the incoming BLAST JSON object into a formatted string\nconst jsonString = JSON.stringify($json, null, 2);\n\n// 2. Extract a Job ID or timestamp for a clean filename\nconst jobId = $json.job_id || $json.body?.job_id || Date.now();\nconst fileName = `blast_result_${jobId}.json`;\n\n// 3. Output both JSON metadata and the Binary data payload\nreturn {\n  json: {\n    job_id: jobId,\n    status: $json.status || 'COMPLETED',\n    file_name: fileName\n  },\n  binary: {\n    data: {\n      data: Buffer.from(jsonString).toString('base64'),\n      mimeType: 'application/json',\n      fileName: fileName\n    }\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

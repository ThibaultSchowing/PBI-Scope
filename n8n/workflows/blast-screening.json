{
  "name": "PBI BLAST Screening + Alerts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "blast-screening",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook (sequence in)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "pbi-blast-screening"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "seq",
              "name": "sequence",
              "value": "={{ $json.sequence }}",
              "type": "string"
            },
            {
              "id": "prog",
              "name": "program",
              "value": "={{ $json.program || \"blastn\" }}",
              "type": "string"
            },
            {
              "id": "db",
              "name": "db",
              "value": "={{ $json.db || \"\" }}",
              "type": "string"
            },
            {
              "id": "notify",
              "name": "notify_to",
              "value": "={{ $json.notify_to }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize-input",
      "name": "Normalize input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "http://api:8000/blast/jobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ sequence: $json.sequence, program: $json.program, db: $json.db || null, max_hits: 10, evalue: 1e-5, timeout: 600, num_threads: 1 }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "create-blast-job",
      "name": "Queue BLAST job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pbi-api-key",
          "name": "PBI API Key"
        }
      }
    },
    {
      "parameters": {
        "waitFor": {
          "seconds": 5
        }
      },
      "id": "wait",
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "http://api:8000/blast/jobs/{{ $json[\"job_id\"] }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "poll-job",
      "name": "Poll BLAST job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1120, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pbi-api-key",
          "name": "PBI API Key"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "done"
            }
          ]
        },
        "options": {}
      },
      "id": "branch-status",
      "name": "Job status?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1340, 200]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "job_id",
              "name": "job_id",
              "value": "={{ $json.job_id }}",
              "type": "string"
            },
            {
              "id": "status",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "error",
              "name": "error",
              "value": "={{ $json.error }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "job-failed",
      "name": "Job failed",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1340, 480]
    },
    {
      "parameters": {
        "url": "http://api:8000/phage-metadata",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "where",
              "value": "Phage_ID IN ('={{ $json.top_hit_phage_id }}')"
            },
            {
              "name": "limit",
              "value": "5"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "annotate-top-hit",
      "name": "Annotate top hit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1560, 200],
      "credentials": {
        "httpHeaderAuth": {
          "id": "pbi-api-key",
          "name": "PBI API Key"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "summary",
              "name": "summary",
              "value": "={{ \"*BLAST screening complete*\\nJob: \" + $json.job_id + \"\\nProgram: \" + $json.program + \"\\nHits: \" + ($json.hits || 0) + \"\\nTop hit: \" + $json.top_hit_phage_id + \" (evalue: \" + $json.top_hit_evalue + \")\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-report",
      "name": "Format report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [1780, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "text": "={{ $json.summary || (\"BLAST job failed for job \" + $json.job_id + \": \" + $json.error) }}",
        "chatId": "={{ $json.notify_to }}"
      },
      "id": "telegram-alert",
      "name": "Telegram alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [2000, 200],
      "credentials": {
        "telegramApi": ""
      }
    }
  ],
  "connections": {
    "Webhook (sequence in)": {
      "main": [
        [
          {
            "node": "Normalize input",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize input": {
      "main": [
        [
          {
            "node": "Queue BLAST job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Queue BLAST job": {
      "main": [
        [
          {
            "node": "Wait 5s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 5s": {
      "main": [
        [
          {
            "node": "Poll BLAST job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll BLAST job": {
      "main": [
        [
          {
            "node": "Job status?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Job status?": {
      "main": [
        [
          {
            "node": "Annotate top hit",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Job failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Annotate top hit": {
      "main": [
        [
          {
            "node": "Format report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format report": {
      "main": [
        [
          {
            "node": "Telegram alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Job failed": {
      "main": [
        [
          {
            "node": "Telegram alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "id": "pbi-blast-screening-workflow",
  "meta": {
    "instanceId": "pbi-local"
  },
  "versionId": "1",
  "tags": []
}
